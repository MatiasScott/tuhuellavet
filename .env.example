APP_NAME="Tu Huella Vet"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/tuhuellavet/public
APP_TIMEZONE=America/Guayaquil

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vet_academic_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=tuhuellavet_session
SESSION_LIFETIME=120
UPLOAD_MAX_BYTES=10485760

# Google Identity / OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/tuhuellavet/public/auth/google/callback

# Contífico. El adaptador queda preparado; configura las credenciales/endpoint productivos.
CONTIFICO_API_URL=
CONTIFICO_API_TOKEN=

# Correo. La implementación actual usa mail() del servidor; estos valores quedan
# reservados para migrar a SMTP/transport configurable si se requiere.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@tuhuellavet.local

# WhatsApp: endpoint HTTP compatible con el proveedor que se configure.
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
