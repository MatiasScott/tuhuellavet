{
  "name": "superarse/tuhuellavet",
  "description": "Tu Huella Vet: sistema veterinario, hacienda y académico en PHP MVC puro",
  "type": "project",
  "require": {
    "php": "^8.2",
    "dompdf/dompdf": "^3.0",
    "google/apiclient": "^2.18",
    "monolog/monolog": "^3.0",
    "phpmailer/phpmailer": "^7.1",
    "phpoffice/phpspreadsheet": "^2.2",
    "symfony/expression-language": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Helpers/url.php",
      "app/Helpers/auth.php",
      "app/Helpers/permission.php",
      "app/Helpers/format.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
        "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  }
}
